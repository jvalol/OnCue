{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ isn't available, so recordings are going here for now." : {
      "comment" : "Settings, under the recordings folder; the argument is the chosen folder",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist nicht verfügbar, deshalb landen Aufnahmen vorerst hier."
          }
        }
      }
    },
    "%@ on %@" : {
      "comment" : "When a schedule window ends; the arguments are a time and a weekday",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ um %1$@"
          }
        }
      }
    },
