    "OnCue is starting with default settings.\nCheck the recordings folder and arm at login in Settings." : {
      "comment" : "Popover notice, two lines",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnCue startet mit Standardeinstellungen.\nPrüfen Sie in den Einstellungen den Aufnahmeordner und das Scharfschalten bei der Anmeldung."
          }
        }
      }
    },
    "OnCue is waiting for its schedule" : {
      "comment" : "Why the Mac is kept awake between schedule windows, as Activity Monitor shows it",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnCue wartet auf seinen Zeitplan"
          }
        }
      }
    },
    "OnCue is writing the last of what it recorded, then it will quit." : {
      "comment" : "Alert text when quitting mid-recording",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnCue schreibt noch den Rest der Aufnahme und beendet sich dann."
          }
        }
      }
    },
    "OnCue isn't allowed to write here, so recordings will fail. Choose somewhere else." : {
      "comment" : "Settings, under the recordings folder",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OnCue darf hier nicht schreiben, Aufnahmen werden fehlschlagen. Wählen Sie einen anderen Ort."
          }
        }
      }
    },
    "OnCue isn't running yet." : {
      "comment" : "Intent error",
      "localizations" : {
